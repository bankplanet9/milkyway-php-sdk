{
    "name": "bankplanet9/milkyway-payments",
    "description": "Official PHP client for the MilkyWay Payments API (/payments/v1) — initiate, quote, track, and cancel cross-bank payments.",
    "type": "library",
    "license": "MIT",
    "keywords": ["milkyway", "payments", "planet9", "fintech", "settlement", "keycloak"],
    "homepage": "https://github.com/bankplanet9/milkyway-php-sdk",
    "authors": [
        {
            "name": "Planet9",
            "homepage": "https://bankplanet9.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "brick/math": "^0.11 || ^0.12",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Bankplanet9\\MilkywayPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bankplanet9\\MilkywayPayments\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
